{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/webapp/src",
  "monorepo": true,
  "root": "apps/webapp",
  "compilerOptions": {
    "webpack": true,
    "tsConfigPath": "apps/webapp/tsconfig.app.json"
  },
  "projects": {
    "sentry": {
      "type": "library",
      "root": "libs/sentry",
      "entryFile": "index",
      "sourceRoot": "libs/sentry/src",
      "compilerOptions": {
        "tsConfigPath": "libs/sentry/tsconfig.lib.json"
      }
    },
    "cloudflare": {
      "type": "library",
      "root": "libs/cloudflare",
      "entryFile": "index",
      "sourceRoot": "libs/cloudflare/src",
      "compilerOptions": {
        "tsConfigPath": "libs/cloudflare/tsconfig.lib.json"
      }
    },
    "google": {
      "type": "library",
      "root": "libs/google",
      "entryFile": "index",
      "sourceRoot": "libs/google/src",
      "compilerOptions": {
        "tsConfigPath": "libs/google/tsconfig.lib.json"
      }
    },
    "llm": {
      "type": "library",
      "root": "libs/llm",
      "entryFile": "index",
      "sourceRoot": "libs/llm/src",
      "compilerOptions": {
        "tsConfigPath": "libs/llm/tsconfig.lib.json"
      }
    },
    "users": {
      "type": "library",
      "root": "libs/users",
      "entryFile": "index",
      "sourceRoot": "libs/users/src",
      "compilerOptions": {
        "tsConfigPath": "libs/users/tsconfig.lib.json"
      }
    },
    "webapp": {
      "type": "application",
      "root": "apps/webapp",
      "entryFile": "main",
      "sourceRoot": "apps/webapp/src",
      "compilerOptions": {
        "tsConfigPath": "apps/webapp/tsconfig.app.json"
      }
    },
    "bot-tg": {
      "type": "application",
      "root": "apps/bot-tg",
      "entryFile": "main",
      "sourceRoot": "apps/bot-tg/src",
      "compilerOptions": {
        "tsConfigPath": "apps/bot-tg/tsconfig.app.json"
      }
    },
    "messenger": {
      "type": "library",
      "root": "libs/messenger",
      "entryFile": "index",
      "sourceRoot": "libs/messenger/src",
      "compilerOptions": {
        "tsConfigPath": "libs/messenger/tsconfig.lib.json"
      }
    },
    "tg-bot": {
      "type": "application",
      "root": "apps/tg-bot",
      "entryFile": "main",
      "sourceRoot": "apps/tg-bot/src",
      "compilerOptions": {
        "tsConfigPath": "apps/tg-bot/tsconfig.app.json"
      }
    }
  }
}